{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tjspace://system2/spatial-world-kernel",
  "title": "TJ SPACE Spatial World Kernel",
  "type": "object",
  "required": ["version", "world", "streaming", "citadel", "entities", "districts", "environment"],
  "properties": {
    "version": {"type": "string", "const": "2.0.0"},
    "world": {
      "type": "object",
      "required": ["units", "coordinateSystem", "origin"],
      "properties": {
        "units": {"type": "string", "const": "centimeters"},
        "coordinateSystem": {"type": "string", "const": "right-handed-z-up"},
        "origin": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3}
      },
      "additionalProperties": false
    },
    "citadel": {
      "type": "object",
      "required": ["worldId", "streamingEnabled", "districtCellSize", "districtLoadingRange"],
      "properties": {
        "worldId": {"type": "string", "minLength": 1},
        "streamingEnabled": {"type": "boolean"},
        "districtCellSize": {"type": "number", "exclusiveMinimum": 0},
        "districtLoadingRange": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": false
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["backendId", "transform", "districtId"],
        "properties": {
          "backendId": {"type": "string", "minLength": 1},
          "transform": {"type": "array", "items": {"type": "number"}, "minItems": 10, "maxItems": 10},
          "districtId": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "districts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "x", "y", "loaded"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "x": {"type": "integer"},
          "y": {"type": "integer"},
          "loaded": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "environment": {
      "type": "object",
      "required": ["health01", "load01", "fault01"],
      "properties": {
        "health01": {"type": "number", "minimum": 0, "maximum": 1},
        "load01": {"type": "number", "minimum": 0, "maximum": 1},
        "fault01": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}