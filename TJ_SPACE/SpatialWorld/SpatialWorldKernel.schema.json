{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tjspace://system2/spatial-world-kernel",
  "title": "TJ SPACE Spatial World Kernel",
  "type": "object",
  "required": ["version", "world", "streaming", "zones"],
  "properties": {
    "version": { "type": "string", "const": "1.0.0" },
    "world": {
      "type": "object",
      "required": ["units", "origin", "coordinateSystem"],
      "properties": {
        "units": { "type": "string", "const": "centimeters" },
        "origin": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
        "coordinateSystem": { "type": "string", "const": "right-handed-z-up" }
      },
      "additionalProperties": false
    },
    "streaming": {
      "type": "object",
      "required": ["enabled", "cellSize", "loadingRange"],
      "properties": {
        "enabled": { "type": "boolean", "const": true },
        "cellSize": { "type": "number", "exclusiveMinimum": 0 },
        "loadingRange": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    },
    "zones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "center", "extent"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9._-]+$" },
          "center": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
          "extent": { "type": "array", "items": { "type": "number", "exclusiveMinimum": 0 }, "minItems": 3, "maxItems": 3 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}